# Dev-only node_modules
node_modules/typescript/**
node_modules/node-gyp/**
node_modules/@types/**
node_modules/tar/**
node_modules/undici/**
node_modules/minipass/**
node_modules/mkdirp/**
node_modules/nopt/**
node_modules/rimraf/**
node_modules/glob/**
node_modules/graceful-fs/**
node_modules/abbrev/**
node_modules/env-paths/**
node_modules/node-addon-api/**

# node-pty: keep Linux build + win32-x64 prebuilts. Drop macOS, arm-win, source, deps.
node_modules/node-pty/src/**
node_modules/node-pty/build/node_gyp_bins/**
node_modules/node-pty/build/config.gypi
node_modules/node-pty/build/Makefile
node_modules/node-pty/build/binding.Makefile
node_modules/node-pty/build/Release/obj.target/**
node_modules/node-pty/build/Release/.deps/**
node_modules/node-pty/.github/**
node_modules/node-pty/deps/**
node_modules/node-pty/prebuilds/darwin-arm64/**
node_modules/node-pty/prebuilds/darwin-x64/**
node_modules/node-pty/prebuilds/win32-arm64/**
node_modules/node-pty/scripts/**
node_modules/node-pty/*.md
node_modules/node-pty/binding.gyp

# xterm: keep only the JS libs and CSS needed at runtime in the webview
node_modules/@xterm/xterm/src/**
node_modules/@xterm/xterm/typings/**
node_modules/@xterm/addon-fit/src/**
node_modules/@xterm/addon-fit/typings/**

# Dev / build artifacts not needed at runtime
src/**/*.ts
tsconfig.json
PLAN.md
.vscode/**
.gitignore
install.sh
*.vsix
