{
  "name": "pi-vscode-sidebar",
  "displayName": "PiDE Piper",
  "description": "PiDE Piper wires the Pi AI coding agent into VS Code as a native terminal with a full sidebar: multi-tab agent management, live model switching, segmented context window bar, project-lifetime cost tracking, session history, package marketplace, 25+ LSP bridge tools, and drag-and-drop file/image context.",
  "version": "0.3.3",
  "private": false,
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/AcendWay/PiDE_Piper_VSCode_Extention.git"
  },
  "bugs": {
    "url": "https://github.com/AcendWay/PiDE_Piper_VSCode_Extention/issues"
  },
  "homepage": "https://github.com/AcendWay/PiDE_Piper_VSCode_Extention#readme",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "pi",
    "pide piper",
    "coding agent",
    "llm",
    "claude",
    "gemini",
    "terminal",
    "sidebar"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "piSidebar",
          "title": "Pi",
          "icon": "media/PiDE_Piper_Logo.svg"
        }
      ]
    },
    "views": {
      "piSidebar": [
        {
          "type": "webview",
          "id": "piSidebar.control",
          "name": "Pi Agent"
        },
        {
          "type": "webview",
          "id": "piSidebar.sessions",
          "name": "Sessions"
        },
        {
          "type": "webview",
          "id": "piSidebar.packages",
          "name": "Packages"
        },
        {
          "type": "webview",
          "id": "piSidebar.dropzone",
          "name": "Drop Context"
        },
        {
          "type": "webview",
          "id": "piSidebar.models",
          "name": "Models"
        }
      ]
    },
    "commands": [
      {
        "command": "piSidebar.open",
        "title": "Pi: Open Terminal",
        "icon": {
          "light": "media/PiDE_Piper_Logo.svg",
          "dark": "media/PiDE_Piper_Logo.svg"
        }
      },
      {
        "command": "piSidebar.openWithFile",
        "title": "Pi: Open with File Context",
        "icon": {
          "light": "media/PiDE_Piper_Logo.svg",
          "dark": "media/PiDE_Piper_Logo.svg"
        }
      },
      {
        "command": "piSidebar.restart",
        "title": "Pi: Restart Terminal"
      },
      {
        "command": "piSidebar.sendSelection",
        "title": "Pi: Send Active File/Selection Context"
      },
      {
        "command": "piSidebar.reviewDiffs",
        "title": "Pi: Review Git Diffs"
      },
      {
        "command": "piSidebar.selectModel",
        "title": "Pi: Select Model"
      },
      {
        "command": "piSidebar.newSession",
        "title": "Pi: New Session"
      },
      {
        "command": "piSidebar.upgrade",
        "title": "Pi: Upgrade Pi and Packages"
      }
    ],
    "keybindings": [
      {
        "command": "piSidebar.open",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "piSidebar.open",
          "group": "navigation"
        },
        {
          "command": "piSidebar.openWithFile",
          "group": "navigation",
          "when": "editorIsOpen"
        }
      ],
      "editor/context": [
        {
          "command": "piSidebar.sendSelection",
          "group": "z_pi@1",
          "when": "editorTextFocus"
        },
        {
          "command": "piSidebar.openWithFile",
          "group": "z_pi@2",
          "when": "editorTextFocus"
        }
      ],
      "explorer/context": [
        {
          "command": "piSidebar.sendSelection",
          "group": "z_pi@1",
          "when": "!explorerResourceIsFolder"
        }
      ]
    },
    "terminal/profiles": [
      {
        "id": "piSidebar.terminalProfile",
        "title": "Pi Agent"
      }
    ],
    "configuration": {
      "title": "Pi Sidebar",
      "properties": {
        "piSidebar.piExecutable": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the pi binary. Leave empty for auto-detection from common install locations."
        },
        "piSidebar.terminalLocation": {
          "type": "string",
          "enum": [
            "beside",
            "panel",
            "active"
          ],
          "default": "beside",
          "description": "Where to open the Pi terminal: beside the editor, in the bottom panel, or in the active editor group."
        },
        "piSidebar.startupArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed to pi on startup. Example: [\"--model\", \"claude-sonnet-4\"]"
        },
        "piSidebar.initialPrompt": {
          "type": "string",
          "default": "You are running inside VS Code via the Pi Sidebar extension. Use available VS Code tools when editor state, diagnostics, diffs, or commands help. Be project and file aware.",
          "description": "System prompt prefix injected when a Pi session starts."
        },
        "piSidebar.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Default model to use when opening Pi. Example: claude-sonnet-4"
        },
        "piSidebar.restoreSessions": {
          "type": "boolean",
          "default": true,
          "description": "Automatically restore Pi sessions when VS Code reloads."
        },
        "piSidebar.showOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Reveal the Pi sidebar when VS Code starts."
        },
        "piSidebar.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically launch a Pi Agent terminal when the extension activates if no Pi terminal is running."
        },
        "piSidebar.idleStaleMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 120,
          "description": "Minutes of inactivity after which a Pi Agent session transitions from idle (yellow) to stale/clear (gray) in the tab strip."
        },
        "piSidebar.tabColorPalette": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "terminal.ansiCyan",
            "terminal.ansiMagenta",
            "terminal.ansiYellow",
            "terminal.ansiBlue",
            "terminal.ansiGreenBright",
            "terminal.ansiRedBright"
          ],
          "description": "VS Code theme color IDs cycled for Pi Agent tabs 2, 3, 4... Tab 1 always uses the default terminal color."
        },
        "piSidebar.showCost": {
          "type": "boolean",
          "default": true,
          "description": "Show running session cost ($) on the right side of the context window bar. Hidden when false or when the active model has zero-cost rates."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ./",
    "package": "npm run compile && npx @vscode/vsce package --allow-missing-repository --no-git-tag-version",
    "package-install": "npm run package && node -e \"const {execSync}=require('child_process'),v=require('./package.json').version;execSync('code --install-extension pi-vscode-sidebar-'+v+'.vsix',{stdio:'inherit'})\"",
    "postversion": "node scripts/sync-version.js",
    "prepackage": "node scripts/sync-version.js"
  },
  "dependencies": {
    "typebox": "^1.0.58"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/vscode": "^1.92.0",
    "node-gyp": "^12.3.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.5"
  },
  "icon": "media/PiDE_Piper_Logo.png"
}
