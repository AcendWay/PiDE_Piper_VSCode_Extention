# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Build outputs ───────────────────────────────────────────────────────────
dist/
out/
*.tsbuildinfo

# ─── Packaged extension artifacts ────────────────────────────────────────────
# Root-level build outputs and any .tgz (npm pack)
*.vsix
*.tgz
# Archive folder: keep the placeholder, ignore the binaries inside
archive_versions/*
!archive_versions/.gitkeep

# ─── Test & coverage output ──────────────────────────────────────────────────
.vscode-test/
coverage/
.nyc_output/
junit.xml
test-results/
.vitest/

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Environment & secrets ───────────────────────────────────────────────────
# Never commit real keys; .env.example is safe to commit as a template
.env
.env.*
!.env.example

# ─── Pi agent runtime data ───────────────────────────────────────────────────
# .pi/ holds project-level pi config (agent definitions etc.) — fine to commit.
# subagent-schedules is scheduler runtime state — never commit.
.pi/

# ─── OS noise ────────────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Windows
Thumbs.db
Desktop.ini
*.lnk
$RECYCLE.BIN/
# Linux
*~

# ─── Editor noise ────────────────────────────────────────────────────────────
# JetBrains (WebStorm, IntelliJ, etc.)
.idea/
*.iml
# Sublime Text
*.sublime-project
*.sublime-workspace
# Vim / Emacs swap files
*.swp
*.swo
*.orig


# ─── Lint & tool caches ──────────────────────────────────────────────────────
.eslintcache
.stylelintcache
.cache/

# ─── Temporary files ─────────────────────────────────────────────────────────
.tmp/
tmp/
temp/
*.pid
*.pid.lock
